# ==========================================
# 图书馆座位预约系统 - 环境变量配置模板
# ==========================================
# 使用说明:
# 1. 复制此文件为 .env (开发环境)
# 2. 根据实际环境修改以下配置值
# 3. 切勿将包含真实配置的.env 文件提交到 Git
# ==========================================

# ------------------------------------------
# 服务器配置
# ------------------------------------------
PORT=3000
NODE_ENV=development

# ------------------------------------------
# 微信配置
# 获取方式:
# 1. 访问 https://mp.weixin.qq.com/
# 2. 注册小程序账号
# 3. 在"开发" -> "开发管理" -> "开发设置"中获取
# 或使用测试号:https://developers.weixin.qq.com/miniprogram/dev/framework/customize/samecity.html
# ------------------------------------------
WX_APP_ID=your_wx_app_id_here
WX_APP_SECRET=your_wx_app_secret_here

# ------------------------------------------
# JWT 配置
# 注意：生产环境务必使用强随机字符串!
# 可使用以下命令生成:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------
# MySQL 数据库配置
# ------------------------------------------
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=your_mysql_password_here
DB_MYSQL_DATABASE=library_booking_dev

# ------------------------------------------
# MongoDB 数据库配置
# ------------------------------------------
DB_MONGODB_URI=mongodb://localhost:27017/library_booking_dev

# ------------------------------------------
# MinIO 对象存储配置
# ------------------------------------------
MINIO_ENDPOINT=your_minio_endpoint_here
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=your_minio_bucket_name_here
MINIO_BASE_URL=http://your_minio_base_url_here
MINIO_PATH_PREFIX=uploads

# ------------------------------------------
# 其他可选配置
# ------------------------------------------
# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 是否启用 Swagger 文档
SWAGGER_ENABLED=true