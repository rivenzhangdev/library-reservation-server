{
    "name": "library-booking-server",
    "version": "1.0.0",
    "description": "图书馆座位预约系统后端服务 - 微信小程序",
    "main": "dist/app.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
        "build": "tsc",
        "start": "node dist/app.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
        "prepare": "husky install",
        "commitlint": "commitlint --edit $1",
        "commit": "git-cz",
        "db:init": "ts-node src/database/init-database.ts",
        "db:reset": "ts-node src/database/reset-database.ts",
        "db:mongo:init": "node tools/init-mongodb.js",
        "swagger": "node scripts/serve-swagger.js",
        "generate:swagger": "ts-node src/generate-swagger-full.ts",
        "switch:env": "node scripts/switch-env.js",
        "switch:env:dev": "node scripts/switch-env.js dev && pnpm dev",
        "switch:env:test": "node scripts/switch-env.js test && pnpm dev",
        "switch:env:uat": "node scripts/switch-env.js uat && pnpm dev",
        "switch:env:prod": "node scripts/switch-env.js prod && pnpm dev",
        "config:env": "node scripts/config-env.js",
        "config:env:check": "node scripts/config-env.js --check"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "keywords": [
        "library",
        "booking",
        "wechat-miniprogram",
        "koa"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@types/node": "^20.10.0",
        "axios": "^1.13.6",
        "bcryptjs": "^2.4.3",
        "dotenv": "^16.3.1",
        "jsonwebtoken": "^9.0.2",
        "koa": "^2.15.0",
        "koa-bodyparser": "^4.4.1",
        "koa-cors": "^0.0.16",
        "koa-jwt": "^4.0.4",
        "koa-router": "^12.0.1",
        "mongoose": "^8.0.3",
        "mysql2": "^3.7.0",
        "sequelize": "^6.35.2",
        "typescript": "^5.3.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^18.4.3",
        "@commitlint/config-conventional": "^18.4.3",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/koa": "^2.14.0",
        "@types/koa-bodyparser": "^4.3.13",
        "@types/koa-cors": "^0.0.4",
        "@types/koa-router": "^7.4.9",
        "@types/koa__cors": "^5.0.0",
        "@typescript-eslint/eslint-plugin": "^8.57.2",
        "@typescript-eslint/parser": "^8.57.2",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.0.1",
        "husky": "8.0.3",
        "lint-staged": "^15.2.0",
        "prettier": "^3.1.1",
        "swagger-ui-dist": "^5.32.1",
        "ts-node-dev": "^2.0.0"
    }
}
